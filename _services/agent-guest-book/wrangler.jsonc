{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcornelia-agent-guest-book",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGIN": "https://mcornelia.com" },
  "durable_objects": { "bindings": [{ "name": "BOOK", "class_name": "GuestBook" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GuestBook"] }],
  "observability": { "enabled": false }
}
